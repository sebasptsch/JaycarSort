{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "JaycarSort",
	"identifier": "dev.sebasptsch.jaycarsort",

	"build": {
		"frontendDist": "../dist/client",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "bun dev --mode tauri",
		"beforeBuildCommand": "bun run build --mode tauri"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "JaycarSort",
				"width": 800,
				"height": 600,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"createUpdaterArtifacts": true
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2QTEyRjBBRUMyOUUyNDQKUldSRTRpbnNDaStodHRqQnR5UnZOKzhKMkVqTU9lcmFyaEFkSWZDKzRMb215b2RKdUhFSmlpRWsK",
			"endpoints": [
				"https://github.com/sebasptsch/JaycarSort/releases/latest/download/latest.json"
			]
		}
	}
}
